// Core: the datasource, the generator, and every model that exists in every
// deploy whatever modules are switched on. Models a module owns live in the
// module's own file next to this one. Every table is always migrated.

datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes"]
}

model User {
  id                     String    @id
  name                   String
  email                  String
  emailVerified          Boolean   @default(false)
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  // True after an admin sets or resets this person's password: they must choose
  // their own before anything else (see apps/api/src/account).
  passwordChangeRequired Boolean   @default(false)
  sessions               Session[]
  accounts               Account[]

  ownedCompanies Company[]           @relation("CompanyOwner")
  ownedContacts  Contact[]           @relation("ContactOwner")
  ownedDeals     Deal[]              @relation("DealOwner")
  activities     Activity[]          @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[]       @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  fieldValues    FieldValue[]        @relation("FieldValueUser")
  savedViews     SavedView[]         @relation("SavedViewOwner")

  createdAgentDefinitions AgentDefinition[]             @relation("AgentDefinitionCreator")
  createdAgentVersions    AgentVersion[]                @relation("AgentVersionCreator")
  createdAgentTriggers    AgentTrigger[]                @relation("AgentTriggerCreator")
  initiatedAgentRuns      AgentRun[]                    @relation("AgentRunInitiator")
  agentAuditEvents        AgentAuditEvent[]             @relation("AgentAuditActor")
  conversationShares      AgentConversationShare[]      @relation("ConversationShareCreator")
  conversationSubmissions AgentConversationSubmission[] @relation("ConversationSubmissionAuthor")
  conversationFeedback    AgentConversationFeedback[]   @relation("ConversationFeedbackAuthor")
  slackMemberMatch        SlackMemberMatch?
  connectedMcpConnections McpConnection[]               @relation("McpConnectionUser")
  mcpOauthStates          McpOauthState[]               @relation("McpOauthStateUser")

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  apiKeys Apikey[]

  @@unique([email])
  @@map("user")
}

model SlackMemberMatch {
  id          String   @id @default(cuid())
  crmUserId   String   @unique
  crmUser     User     @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  slackUserId String?
  slackHandle String?
  slackEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slackUserId])
  @@map("slackMemberMatch")
}

model SlackChannel {
  id                String    @id
  name              String
  memberCount       Int?
  available         Boolean   @default(true)
  isPrivate         Boolean   @default(false)
  isMember          Boolean   @default(false)
  inviteRequestedAt DateTime?
  classifiedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([available, name])
  @@index([updatedAt])
  @@map("slackChannel")
}

model SlackInstallation {
  installerId String   @id
  teamId      String
  teamName    String?
  userToken   String?
  userScopes  String
  createdAt   DateTime @default(now())

  @@map("slackInstallation")
}

model SlackWorkspaceGrant {
  id         String   @id @default(cuid())
  teamId     String   @unique
  teamName   String?
  userToken  String
  userScopes String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("slackWorkspaceGrant")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

enum McpConnectionStatus {
  CONNECTING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum McpAccessMode {
  READ_ONLY
  READ_WRITE
}

enum McpToolReviewState {
  PENDING
  REVIEWED
  CHANGED
  REMOVED
}

model McpConnection {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platformSlug  String
  status        McpConnectionStatus @default(CONNECTING)
  accessMode    McpAccessMode
  grantedScopes String[]

  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?

  registrationId String
  registration   McpClientRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  connectedById String
  connectedBy   User   @relation("McpConnectionUser", fields: [connectedById], references: [id], onDelete: Restrict)

  connectedAt          DateTime?
  lastSuccessfulCallAt DateTime?
  lastErrorCode        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  toolSnapshots McpToolSnapshot[]

  @@unique([organizationId, platformSlug])
  @@index([status, updatedAt])
  @@map("mcpConnection")
}

model McpClientRegistration {
  id String @id @default(cuid())

  platformSlug                     String
  metadataFingerprint              String
  issuer                           String
  clientId                         String
  encryptedClientSecret            String?
  encryptedRegistrationAccessToken String?
  clientIdIssuedAt                 DateTime?
  clientSecretExpiresAt            DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  connections McpConnection[]
  oauthStates McpOauthState[]

  @@unique([platformSlug, metadataFingerprint])
  @@index([clientSecretExpiresAt])
  @@map("mcpClientRegistration")
}

model McpToolSnapshot {
  id String @id @default(cuid())

  connectionId String
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  name        String
  description String?
  inputSchema Json
  annotations Json?
  fingerprint String
  callKind    String
  reviewState McpToolReviewState @default(PENDING)
  lastSeenAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@unique([connectionId, name, fingerprint])
  @@index([connectionId, name, lastSeenAt])
  @@index([reviewState, lastSeenAt])
  @@map("mcpToolSnapshot")
}

model McpOauthState {
  id String @id @default(cuid())

  stateHash      String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("McpOauthStateUser", fields: [userId], references: [id], onDelete: Cascade)

  platformSlug          String
  accessMode            McpAccessMode
  returnPath            String
  encryptedCodeVerifier String
  registrationId        String
  registration          McpClientRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime              @default(now())

  @@index([expiresAt, consumedAt])
  @@map("mcpOauthState")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentConversationPermissionMode {
  MANUAL
  AUTO
  BYPASS
}

enum AgentResponseRating {
  UP
  DOWN
}

model AgentTask {
  id        String  @id @default(cuid())
  contactId String?
  companyId String?
  dealId    String?

  kind    String
  reason  String
  payload Json?

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  subject String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([dealId])
  @@index([kind, subject], where: { finishedAt: null })
  @@map("agentTask")
}

model AgentEvent {
  id             String             @id
  sessionId      String
  streamIndex    Int?
  deliveryIds    String[]           @default([])
  contactId      String?
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  data           Json
  encryptedData  String?

  emittedAt DateTime

  @@unique([sessionId, streamIndex])
  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@index([conversationId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  sessionId           String? @unique
  continuationToken   String?
  streamIndex         Int     @default(0)
  pendingInputRequest Json?

  permissionMode AgentConversationPermissionMode @default(MANUAL)

  title        String?
  messageCount Int     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime  @default(now())
  lastAssistantAt DateTime?
  lastReadAt      DateTime?

  shares           AgentConversationShare[]
  submissions      AgentConversationSubmission[]
  feedback         AgentConversationFeedback[]
  events           AgentEvent[]
  createdVersions  AgentVersion[]                @relation("AgentVersionSourceConversation")
  builderArtifacts AgentBuilderArtifact[]

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@map("agentConversation")
}

model AgentConversationFeedback {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  rating    AgentResponseRating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
  @@map("agentConversationFeedback")
}

model AgentConversationShare {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ConversationShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  scope     AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash String                      @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([conversationId], map: "agentConversationShare_one_active_per_conversation", where: { revokedAt: null })
  @@index([conversationId, revokedAt])
  @@map("agentConversationShare")
}

model AgentConversationSubmission {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ConversationSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  clientRequestId String                            @unique
  inputRequestId  String?
  commandType     AgentConversationCommandType      @default(CHAT)
  message         Json
  status          AgentConversationSubmissionStatus @default(PENDING)
  attemptCount    Int                               @default(0)

  errorCode    String?
  errorMessage String?

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?

  attachments AgentConversationAttachment[]

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("agentConversationSubmission")
}

model AgentConversationAttachment {
  id String @id @default(cuid())

  submissionId String
  submission   AgentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  content   Bytes
  position  Int

  createdAt DateTime @default(now())

  @@index([submissionId, position])
  @@map("agentConversationAttachment")
}

model AgentDefinition {
  id String @id @default(cuid())

  name        String
  description String?
  status      AgentDefinitionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("AgentDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("CurrentAgentVersion", fields: [currentVersionId, id], references: [id, agentId], onDelete: Restrict)

  versions      AgentVersion[]      @relation("AgentVersions")
  triggers      AgentTrigger[]
  runs          AgentRun[]
  actions       AgentAction[]
  auditEvents   AgentAuditEvent[]
  conversations AgentConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@unique([currentVersionId, id])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@map("agentDefinition")
}

model AgentVersion {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Restrict)

  number Int
  status AgentVersionStatus @default(DRAFT)

  instructions             String
  manifest                 Json
  modelId                  String
  modelContextWindowTokens Int    @default(1000000)
  sandboxPolicy            Json
  validation               Json?

  sourceConversationId String?
  sourceConversation   AgentConversation? @relation("AgentVersionSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AgentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  deploymentId String?
  approvedAt   DateTime?
  deployedAt   DateTime?
  createdAt    DateTime  @default(now())

  currentFor       AgentDefinition?       @relation("CurrentAgentVersion")
  triggers         AgentTrigger[]
  runs             AgentRun[]
  auditEvents      AgentAuditEvent[]
  builderArtifacts AgentBuilderArtifact[]

  @@unique([agentId, number])
  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@map("agentVersion")
}

model AgentBuilderArtifact {
  id String @id @default(cuid())

  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  path            String
  language        String
  content         String
  previousContent String?
  revision        Int
  status          AgentBuilderArtifactStatus @default(WRITING)
  createdAt       DateTime                   @default(now())

  @@unique([conversationId, path, revision], map: "agentBuilderArtifact_conversation_path_revision_key", where: { conversationId: { not: null } })
  @@unique([versionId, path, revision], map: "agentBuilderArtifact_version_path_revision_key", where: { versionId: { not: null } })
  @@index([conversationId, createdAt])
  @@index([versionId, path])
  @@map("agentBuilderArtifact")
}

model AgentTrigger {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  type   AgentTriggerType
  name   String
  config Json

  createdById String
  createdBy   User   @relation("AgentTriggerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  enabled   Boolean   @default(false)
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runs AgentRun[]

  @@unique([id, agentId])
  @@index([agentId, enabled])
  @@index([enabled, nextRunAt])
  @@index([versionId])
  @@map("agentTrigger")
}

model AgentRun {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  triggerId String?
  trigger   AgentTrigger? @relation(fields: [triggerId, agentId], references: [id, agentId], onDelete: Restrict)

  initiatedById String?
  initiatedBy   User?   @relation("AgentRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  triggerType    AgentTriggerType
  status         AgentRunStatus   @default(QUEUED)
  principalId    String?
  sessionId      String?          @unique
  idempotencyKey String           @unique
  correlationId  String           @unique

  input   Json?
  result  Json?
  summary String?

  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  errorCode    String?
  errorMessage String?

  nextEventSequence Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  cancelRequestedAt DateTime?
  cancelDeliveredAt DateTime?

  events  AgentRunEvent[]
  actions AgentAction[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([versionId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@map("agentRun")
}

model AgentRunEvent {
  id String @id @default(cuid())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  sequence  Int
  type      String
  data      Json
  emittedAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, emittedAt])
  @@map("agentRunEvent")
}

model AgentAction {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  runId String
  run   AgentRun @relation(fields: [runId, agentId], references: [id, agentId], onDelete: Restrict)

  type        String
  provider    String
  targetType  String?
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?

  status         AgentActionStatus @default(PLANNED)
  idempotencyKey String            @unique
  requestHash    String?
  externalId     String?
  attemptCount   Int               @default(0)

  errorCode    String?
  errorMessage String?

  plannedAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([agentId, plannedAt])
  @@index([runId, plannedAt])
  @@index([provider, externalId])
  @@index([status, plannedAt])
  @@map("agentAction")
}

model AgentAuditEvent {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  actorUserId String?
  actorUser   User?   @relation("AgentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  type      String
  actorType String
  actorId   String?
  summary   String
  before    Json?
  after     Json?
  requestId String?
  emittedAt DateTime @default(now())

  @@unique([agentId, type, requestId])
  @@index([agentId, emittedAt])
  @@index([versionId, emittedAt])
  @@index([actorUserId, emittedAt])
  @@index([type, emittedAt])
  @@map("agentAuditEvent")
}

enum RateSource {
  FETCHED
  MANUAL
}

model ExchangeRate {
  id            String     @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(20, 10)
  asOf          DateTime
  source        RateSource
  provider      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([baseCurrency, quoteCurrency, source])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchangeRate")
}

enum FieldEntity {
  COMPANY
  CONTACT
  DEAL
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  URL
  EMAIL
  PHONE
  USER
}

model FieldDefinition {
  id     String      @id @default(cuid())
  entity FieldEntity
  key    String
  label  String
  type   FieldType

  agentFilled Boolean @default(true)
  agentBrief  String?

  required     Boolean @default(false)
  showOnSheet  Boolean @default(true)
  showOnTable  Boolean @default(false)
  showOnFilter Boolean @default(false)
  position     Int

  archivedAt DateTime?

  options FieldOption[]
  values  FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, key])
  @@index([entity, position])
  @@map("fieldDefinition")
}

model FieldOption {
  id       String          @id @default(cuid())
  fieldId  String
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label    String
  position Int

  archivedAt DateTime?
  values     FieldValue[]

  @@index([fieldId, position])
  @@map("fieldOption")
}

model FieldValue {
  id      String          @id @default(cuid())
  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  text     String?
  number   Decimal?     @db.Decimal(24, 4)
  date     DateTime?
  bool     Boolean?
  optionId String?
  option   FieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?        @relation("FieldValueUser", fields: [userId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([fieldId, companyId])
  @@unique([fieldId, contactId])
  @@unique([fieldId, dealId])
  @@index([fieldId, text])
  @@index([fieldId, number])
  @@index([fieldId, date])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([optionId])
  @@index([userId])
  @@map("fieldValue")
}

model SavedView {
  id      String      @id @default(cuid())
  entity  FieldEntity
  name    String
  shared  Boolean     @default(false)
  filters Json

  ownerId String
  owner   User   @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, ownerId, name])
  @@index([entity, shared])
  @@map("savedView")
}

model AppSetting {
  id String @id

  agentModelId String?

  agentModelContextWindow Int?

  contextDevApiKey String?

  reportingCurrency String?

  ratesRefreshedAt DateTime?

  archiveRetentionDays Int @default(180)

  trackingSiteId           String? @unique
  trackingCrossDomain      Boolean @default(true)
  trackingLimitToDomains   Boolean @default(true)
  trackingCookieSubdomains Boolean @default(false)
  trackingSecureCookies    Boolean @default(true)
  trackingHonourDnt        Boolean @default(true)
  trackingCookieDays       Int     @default(395)
  trackingConfigHash       String?
  trackingPaused           Boolean @default(false)

  // The user id the developer account is pinned to (set the first time the
  // DEVELOPER_EMAIL address signs in). Plain string, no relation, like AuditEvent.
  developerUserId String?

  updatedAt DateTime @updatedAt

  @@map("appSetting")
}

model Install {
  id String @id

  uuid    String @unique
  version String

  lastRollupAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("install")
}

model TelemetryMilestone {
  step      String   @id
  reachedAt DateTime @default(now())

  @@map("telemetryMilestone")
}

model TelemetryCounter {
  name      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("telemetryCounter")
}

model Organization {
  id             String          @id
  name           String
  slug           String
  logo           String?
  createdAt      DateTime
  metadata       String?
  website        String?
  members        Member[]
  invitations    Invitation[]
  mcpConnections McpConnection[]
  mcpOauthStates McpOauthState[]

  @@unique([slug])
  @@map("organization")
}

model WorkspaceProfile {
  id String @id

  website   String
  narrative String
  sections  Json

  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("workspaceProfile")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([referenceId])
  @@index([configId])
  @@index([key])
  @@map("apikey")
}

model SchedulerRun {
  job String @id

  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?

  updatedAt DateTime @updatedAt

  @@map("schedulerRun")
}

// Core, append-only: the database refuses UPDATE, DELETE and TRUNCATE (triggers
// audit_append_only and audit_no_truncate, hand-written in the migration).
// Written only by writeAudit() in the caller's transaction.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  module     String
  actorType  String
  actorId    String?
  actorLabel String?
  action     String
  entityType String
  entityId   String
  summary    String
  before     Json?
  after      Json?
  reason     String?
  requestId  String?

  @@index([entityType, entityId, at])
  @@index([module, action, at])
  @@index([actorId, at])
  @@map("auditEvent")
}

// Core. One row per module the developer account has explicitly switched on or
// off. No row means the client's starting set (clients/<id>/client.config.ts)
// decides. Switching never deletes a module's data. Written only by the
// developer-only modules.set procedure, in a transaction with its audit event.
model ModuleSwitch {
  moduleId    String   @id
  enabled     Boolean
  changedById String?
  changedAt   DateTime @default(now()) @updatedAt

  @@map("moduleSwitch")
}
