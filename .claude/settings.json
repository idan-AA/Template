{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "statusMessage": "Checking git command..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-review.mjs\"",
            "timeout": 1200,
            "statusMessage": "Opus is reviewing the staged changes before commit..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse_bash.py\"'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse_code.py\"'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse_code.py\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_no_em_dash.py\"'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome",
      "mcp__chrome-devtools",
      "Read",
      "Edit",
      "Write",
      "Bash(*)",
      "WebSearch",
      "WebFetch(*)",
      "Grep",
      "Glob",
      "PowerShell(*)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .:*)",
      "Bash(git clean:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.render)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)",
      "PowerShell(gc .env*)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ],
    "defaultMode": "bypassPermissions"
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enabledPlugins": {
    "paper-desktop@paper": true
  }
}
